# MedEasy Backend — Environment Variables
# Copy this file to .env and fill in your values

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3001

# ── JWT ─────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite file path (relative to server/)
DB_PATH=./medeasy.db

# ── n8n Webhooks ─────────────────────────────────────────────────────────────
# Leave blank to use local AI fallback responses
N8N_INSURANCE_WEBHOOK=
N8N_TRIAGE_WEBHOOK=
N8N_HOSPITALS_WEBHOOK=
N8N_BOOKING_WEBHOOK=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Frontend origin (for production, set to your Vercel URL)
ALLOWED_ORIGIN=http://localhost:5500
